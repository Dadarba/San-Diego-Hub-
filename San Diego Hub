local function RunConnectionTest()
    SendNotification("Проверка...", Color3.fromRGB(255, 170, 0))
    local requestFunc = syn and syn.request or request or http_request
    local resp = nil
    if requestFunc then
        resp = requestFunc({
            Url = GITHUB_URL .. "?t=" .. tick(),
            Method = "GET",
            Headers = {["User-Agent"] = "Mozilla/5.0"},
            Timeout = 5
        })
    else
        local success, data = pcall(function()
            return game:HttpGet(GITHUB_URL .. "?t=" .. tick())
        end)
        if success then
            resp = {Body = data, StatusCode = 200}
        else
            resp = {StatusCode = 500}
        end
    end
    if resp and resp.StatusCode == 200 and resp.Body and #resp.Body > 0 then
        local lines = 0
        for _ in resp.Body:gmatch("[^\r\n]+") do lines = lines + 1 end
        SendNotification("✅ GitHub работает! Строк: " .. lines, Color3.fromRGB(80, 255, 80))
    else
        SendNotification("❌ Ошибка! Код: " .. (resp and resp.StatusCode or "нет"), Color3.fromRGB(255, 80, 80))
    end
end
TestBtn.Activated:Connect(RunConnectionTest)

local function OnLoginSuccess(premium)
    isAuthenticated = true
    isPremium = premium
    LoginFrame:Destroy()
    toggleButton.Visible = true
    MainUI.Visible = true
    isMenuOpen = true
    if premium then
        wait(0.5)
        applyMods()
    end
end

LoginBtn.Activated:Connect(function()
    local input = KeyBox.Text
    if input == "" then
        SendNotification("Введите ключ!", Color3.fromRGB(255, 80, 80))
        return
    end
    SendNotification("Связь с сервером...", Color3.fromRGB(0, 120, 215))
    local done = false
    local success = false
    local status = nil
    local co = coroutine.create(function()
        local ok, succ, stat = pcall(ValidateSecureKey, input)
        if ok then
            success = succ
            status = stat
        else
            status = "Ошибка: " .. tostring(succ)
        end
        done = true
    end)
    coroutine.resume(co)
    local start = tick()
    while not done and tick() - start < 6 do
        wait(0.1)
    end
    if not done then
        SendNotification("Таймаут!", Color3.fromRGB(255, 80, 80))
        return
    end
    if not success then
        if status == "NOT_ACTIVATED" then
            SendNotification("Ключ ожидает активации. Уведомление отправлено.", Color3.fromRGB(255, 170, 0))
        elseif status == "HWID_MISMATCH" then
            SendNotification("Ключ привязан к другому HWID!", Color3.fromRGB(255, 80, 80))
        elseif status == "KEY_ALREADY_USED" then
            SendNotification("Ключ уже использован!", Color3.fromRGB(255, 80, 80))
        elseif status == "KEY_EXPIRED" then
            SendNotification("Срок ключа истёк!", Color3.fromRGB(255, 80, 80))
        elseif status == "KEY_NOT_FOUND" then
            SendNotification("Ключ не найден!", Color3.fromRGB(255, 80, 80))
        else
            SendNotification("Ошибка: " .. tostring(status), Color3.fromRGB(255, 80, 80))
        end
    else
        if status == "SUCCESS" then
            pcall(function()
                if writefile then writefile(keyFileName, input) end
            end)
            SendNotification("Доступ разрешен!", Color3.fromRGB(80, 255, 80))
            OnLoginSuccess(true)
        else
            SendNotification("Неизвестно: " .. tostring(status), Color3.fromRGB(255, 80, 80))
        end
    end
end)

