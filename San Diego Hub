local function ValidateSecureKey(inputKey)
    log("Начало проверки ключа: " .. inputKey, "INFO")
    inputKey = inputKey:gsub("^%s*(.-)%s*$", "%1")
    if inputKey == "" then return false, "EMPTY_KEY" end

    local ok, result = pcall(function()
        local requestFunc = syn and syn.request or request or http_request
        local resp = nil
        if requestFunc then
            resp = requestFunc({
                Url = GITHUB_URL .. "?t=" .. tick(),
                Method = "GET",
                Headers = {
                    ["User-Agent"] = "Mozilla/5.0",
                    ["Cache-Control"] = "no-cache, no-store, must-revalidate"
                },
                Timeout = 5
            })
        else
            local success, data = pcall(function()
                return game:HttpGet(GITHUB_URL .. "?t=" .. tick())
            end)
            if success then
                resp = {Body = data, StatusCode = 200}
            else
                resp = {StatusCode = 500}
            end
        end

        if type(resp) ~= "table" then
            return {false, "RESPONSE_NOT_TABLE: " .. tostring(resp)}
        end
        if resp.StatusCode ~= 200 then
            return {false, "BAD_STATUS: " .. tostring(resp.StatusCode)}
        end
        if not resp.Body or #resp.Body == 0 then
            return {false, "EMPTY_BODY"}
        end

        local lines = {}
        for line in resp.Body:gmatch("[^\r\n]+") do
            if line ~= "" then table.insert(lines, line) end
        end
        if #lines == 0 then
            return {false, "NO_LINES"}
        end

        for _, encodedLine in ipairs(lines) do
            local base64decoded = DecodeBase64(encodedLine)
            if base64decoded ~= "" then
                local decrypted = xor_encrypt(base64decoded, XOR_KEY)
                log("Расшифрованная строка: " .. decrypted, "INFO")
                if decrypted ~= "" then
                    local keyPart, hwidPart, timePart = decrypted:match("([^:]+):([^:]+):?([^:]*)")
                    if keyPart and hwidPart then
                        keyPart = keyPart:gsub("^%s*(.-)%s*$", "%1")
                        hwidPart = hwidPart:gsub("^%s*(.-)%s*$", "%1")
                        timePart = timePart:gsub("^%s*(.-)%s*$", "%1")

                        if keyPart == inputKey then
                            local expired = false
                            if timePart ~= "" then
                                local expireTime = tonumber(timePart)
                                if expireTime and os.time() > expireTime then
                                    expired = true
                                end
                            end
                            if not expired then
                                if hwidPart == "NONE" then
                                    SendWebhookAsync(inputKey, MyHWID)
                                    return {false, "NOT_ACTIVATED"}
                                elseif hwidPart == MyHWID then
                                    return {true, "SUCCESS"}
                                elseif hwidPart == "USED" then
                                    return {false, "KEY_ALREADY_USED"}
                                else
                                    return {false, "HWID_MISMATCH"}
                                end
                            end
                        end
                    end
                end
            end
        end

        return {false, "KEY_NOT_FOUND"}
    end)

    if not ok then
        return false, "INTERNAL_ERROR: " .. tostring(result)
    end
    if type(result) ~= "table" then
        return false, "PCALL_RESULT_NOT_TABLE: " .. tostring(result)
    end
    return unpack(result)
end

