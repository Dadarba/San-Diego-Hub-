-- Восстановление сессии
pcall(function()
    if isfile and isfile(keyFileName) then
        local savedKey = readfile(keyFileName)
        if savedKey and savedKey ~= "" then
            local ok, succ, stat = pcall(ValidateSecureKey, savedKey)
            if ok and succ and stat == "SUCCESS" then
                SendNotification("Сессия восстановлена.", Color3.fromRGB(80, 255, 80))
                OnLoginSuccess(true)
            else
                if delfile then delfile(keyFileName) end
            end
        end
    end
end)

