-- XOR (без bit32)
local function xor_encrypt(data, key)
    local result = ""
    for i = 1, #data do
        local a = string.byte(data, i)
        local b = string.byte(key, (i - 1) % #key + 1)
        result = result .. string.char((a ~ b) % 256)
    end
    return result
end

-- BASE64 DECODE
local b64chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'
local function DecodeBase64(data)
    if not data or data == "" then return "" end
    data = string.gsub(data, '[^'..b64chars..'=]', '')
    if #data == 0 then return "" end
    while #data % 4 ~= 0 do data = data .. '=' end
    local result = ""
    for i = 1, #data, 4 do
        local chunk = data:sub(i, i+3)
        local n = 0
        for j = 1, 4 do
            local c = chunk:sub(j, j)
            if c ~= '=' then
                local idx = b64chars:find(c) - 1
                if idx then n = n * 64 + idx end
            end
        end
        local b1 = math.floor(n / 65536) % 256
        local b2 = math.floor(n / 256) % 256
        local b3 = n % 256
        result = result .. string.char(b1)
        if chunk:sub(3,3) ~= '=' then result = result .. string.char(b2) end
        if chunk:sub(4,4) ~= '=' then result = result .. string.char(b3) end
    end
    return result
end

