            local y = 13 * math.cos(t) - 5 * math.cos(2*t) - 2 * math.cos(3*t) - math.cos(4*t)
            local scale = 0.05 * spread
            local part = Instance.new("Part")
            part.Size = Vector3.new(0.15, 0.15, 0.15)
            part.Position = position + Vector3.new(x * scale, y * scale + 0.5, 0)
            part.BrickColor = BrickColor.new(color)
            part.Anchored = true
            part.CanCollide = false
            part.Parent = workspace
            local goal = {}
            goal.Size = Vector3.new(0.25, 0.25, 0.25)
            goal.Position = position + Vector3.new(x * scale * 1.2, y * scale * 1.2 + 0.5, 0)
            local tween = TweenService:Create(part, TweenInfo.new(time, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), goal)
            tween:Play()
            Debris:AddItem(part, time + 0.2)
            table.insert(parts, part)
        end
    end
    return parts
end

